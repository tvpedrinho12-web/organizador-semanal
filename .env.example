# Copie para .env e preencha. Estas variáveis vão nas Environment Variables do Vercel.
VAPID_PUBLIC=            # chave pública VAPID (também vai no config.js do cliente)
VAPID_PRIVATE=          # chave privada VAPID (SEGREDO — só no servidor)
VAPID_SUBJECT=mailto:voce@exemplo.com
QSTASH_TOKEN=           # token do Upstash QStash
SEND_SECRET=            # senha aleatória longa que protege o /api/send
